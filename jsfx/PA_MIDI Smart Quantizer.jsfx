  menu_result ? parameter(3,menu_result-1);
);
sprintf(#root_label,"Root: %s",pc_name(cfg_root));
button(170,140,104,32,#root_label,0) ? parameter(5,note_menu(cfg_root));
sprintf(#preset_label,"Scale: %s",preset_name(cfg_preset));
button(282,140,290,32,#preset_label,0) ? (
  strcpy(#preset_menu,""); i=0;
  loop(11,
    i ? strcat(#preset_menu,"|");
    i==cfg_preset ? strcat(#preset_menu,"!");
    strcat(#preset_menu,preset_name(i)); i+=1;
  );
  gfx_x=mouse_x; gfx_y=mouse_y; menu_result=gfx_showmenu(#preset_menu);
  menu_result ? (
    parameter(6,menu_result-1);
    menu_result>1 ? parameter(4,preset_mask(menu_result-1,cfg_root));
  );
);
button(580,140,216,32,"Reset: chromatic",0) ? (
  parameter(6,1); parameter(4,4095);
);

cfg_mode==2 ? (
  ui_text(24,185,772,23,"PITCH-CLASS MAPPING  /  click an output note to change it",13,0.58,0.65,0.73,0);
  i=0;
  loop(12,
    x=24+i*65;
    ui_text(x,217,57,24,pc_name(i),14,0.61,0.68,0.76,5);
    button(x,249,57,53,pc_name(slider(8+i)),0) ? parameter(8+i,note_menu(slider(8+i)));
    i+=1;
  );
  ui_text(24,311,580,23,"Mapping uses the same octave and ignores the scale selection.",12,0.50,0.57,0.65,0);
  button(626,309,170,28,"Identity mapping",0) ? (
    i=0; loop(12, parameter(8+i,i); i+=1;);
  );
) : (
  ui_text(24,185,772,23,"ALLOWED NOTES  /  click piano keys to edit freely",13,0.58,0.65,0.73,0);
  piano(24,216,772,106,0);
);

cfg_mode==1 ? (
  button(24,327,196,22,"Reference: Base",!cfg_relative_ref) ? parameter(21,0);
  button(224,327,218,22,"Reference: Last note",cfg_relative_ref) ? parameter(21,1);
);

// Show the actual input reference, including a released last-note reference.
ui_ref_channel=last_channel;
ui_ref=cfg_mode==1 ? (cfg_relative_ref ? relative_last_input[ui_ref_channel]>=0 : reference[ui_ref_channel]>0) : 0;
!ui_ref && cfg_mode==1 ? (
  i=0;
  loop(16,
    !ui_ref && (cfg_relative_ref ? relative_last_input[i]>=0 : reference[i]>0) ? (
      ui_ref=1; ui_ref_channel=i;
    );
    i+=1;
  );
);
ui_rect(24,350,772,46,0.10,0.13,0.17);
ui_ref ? (
  cfg_relative_ref ? (
    ui_ref_in=relative_last_input[ui_ref_channel]; ui_ref_out=relative_cursor[ui_ref_channel];
  ) : (
    p=voices+(reference[ui_ref_channel]-1)*STRIDE;
    ui_ref_in=p[0]%128; ui_ref_out=p[1];
  );
  format_note(ui_ref_in,#ref_in); format_note(ui_ref_out,#ref_out);
  format_note(relative_cursor[ui_ref_channel],#cursor_note);
  sprintf(#ref_label,"%s / Ch %d   %s > %s   |   CURSOR %s",cfg_relative_ref?"LAST NOTE":"BASE",ui_ref_channel+1,#ref_in,#ref_out,#cursor_note);
  ui_text(36,350,748,46,#ref_label,13,0.98,0.76,0.33,4);
) : ui_text(36,350,748,46,cfg_mode==1?"REFERENCE  /  play a note to anchor the next intervals":"Independent pitch processing",14,0.58,0.65,0.73,4);

